# Public / App URL
APP_URL=http://localhost:3000

# Supabase (local or sekka-dev; NEVER commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (use official test keys on Preview/Local only)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog Analytics (disabled until key is provided)
NEXT_PUBLIC_POSTHOG_KEY=

# Error tracking (optional in W0/W1)
SENTRY_DSN=

# Gallery visibility flag for CI / non-production local builds
ENABLE_STYLEGUIDE=true
